DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
ALLOWED_HOSTS=kalaichol.example.com
CSRF_TRUSTED_ORIGINS=https://kalaichol.example.com
SITE_URL=https://kalaichol.example.com
POSTGRES_PASSWORD=change-me
# real confirmation mails (leave EMAIL_HOST empty in development: mail prints to the log)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=கலைச்சொல் <no-reply@example.com>
REVIEW_THRESHOLD=2
# Hugging Face dataset sync
HF_TOKEN=

# Telegram admin group: create a bot with @BotFather, add it to the group, then
#   TELEGRAM_CHAT_ID = the group's id (negative number), TELEGRAM_ADMIN_IDS = Telegram user ids allowed to press Approve/Reject
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ADMIN_IDS=
TELEGRAM_WEBHOOK_SECRET=
# 1 = new accounts must be approved by an admin before they can suggest, rate or review
REQUIRE_USER_APPROVAL=0
