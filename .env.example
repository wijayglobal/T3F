# generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
ALLOWED_HOSTS=kalaichol.example.com
CSRF_TRUSTED_ORIGINS=https://kalaichol.example.com
SITE_URL=https://kalaichol.example.com
POSTGRES_PASSWORD=change-me
# host port for the web container (bound to 127.0.0.1; the reverse proxy points here)
WEB_PORT=8081
# real confirmation mails (leave EMAIL_HOST empty in development: mail prints to the log)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=கலைச்சொல் <no-reply@example.com>
REVIEW_THRESHOLD=2
# Hugging Face dataset sync
HF_TOKEN=

# Telegram admin group: create a bot with @BotFather, add it to the group, then
#   TELEGRAM_CHAT_ID = the group's id (negative number), TELEGRAM_ADMIN_IDS = Telegram user ids allowed to press Approve/Reject
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ADMIN_IDS=
TELEGRAM_WEBHOOK_SECRET=
# 1 = new accounts must be approved by an admin before they can suggest, rate or review
REQUIRE_USER_APPROVAL=0

# --- security (see README "Security")
# HSTS max-age in seconds once HTTPS works (0 turns it off). Subdomains/preload are opt-in.
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=0
SECURE_HSTS_PRELOAD=0
# 1 = Django redirects http -> https itself (Caddy already does this)
SECURE_SSL_REDIRECT=0
# suggestions, ratings, reports and review votes allowed per user per minute (0 = no limit)
WRITE_RATE_LIMIT=30
