# Add to the server's existing Caddyfile (Caddy fetches the HTTPS certificate itself).
# The port must match WEB_PORT in .env (default 8081).
kalaichol.example.com {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8081
}

