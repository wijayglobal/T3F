{
  "settings": {
    "index": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "refresh_interval": "1s",
      "max_ngram_diff": 18,
      "knn": true
    },
    "analysis": {
      "char_filter": {
        "ta_clean": {
          "type": "mapping",
          "mappings": [
            "\\u200C=>",
            "\\u200D=>",
            "\\u00AD=>",
            "ா்=>ர்",
            "ை்=>ய்"
          ]
        }
      },
      "tokenizer": {
        "edge_1_20": {
          "type": "edge_ngram",
          "min_gram": 1,
          "max_gram": 20,
          "token_chars": [
            "letter",
            "digit",
            "whitespace",
            "punctuation"
          ]
        }
      },
      "filter": {
        "ta_nfc": {
          "type": "icu_normalizer",
          "name": "nfc"
        },
        "edge_1_15": {
          "type": "edge_ngram",
          "min_gram": 1,
          "max_gram": 15
        },
        "gram_2_3": {
          "type": "ngram",
          "min_gram": 2,
          "max_gram": 3
        },
        "gram_3": {
          "type": "ngram",
          "min_gram": 3,
          "max_gram": 3
        },
        "en_possessive": {
          "type": "stemmer",
          "language": "possessive_english"
        },
        "en_stem": {
          "type": "stemmer",
          "language": "light_english"
        },
        "rk_long_vowels": {
          "type": "pattern_replace",
          "pattern": "([aeiou])\\1+",
          "replacement": "$1"
        },
        "rk_zh": {
          "type": "pattern_replace",
          "pattern": "zh|z",
          "replacement": "l"
        },
        "rk_aspirates": {
          "type": "pattern_replace",
          "pattern": "([kgcjtdpb])h",
          "replacement": "$1"
        },
        "rk_sh": {
          "type": "pattern_replace",
          "pattern": "sh|ch|s|j",
          "replacement": "c"
        },
        "rk_voicing": {
          "type": "pattern_replace",
          "pattern": "g",
          "replacement": "k"
        },
        "rk_voicing_d": {
          "type": "pattern_replace",
          "pattern": "d",
          "replacement": "t"
        },
        "rk_voicing_b": {
          "type": "pattern_replace",
          "pattern": "b|f",
          "replacement": "p"
        },
        "rk_w": {
          "type": "pattern_replace",
          "pattern": "w",
          "replacement": "v"
        },
        "rk_ee": {
          "type": "pattern_replace",
          "pattern": "ee",
          "replacement": "i"
        },
        "rk_oo": {
          "type": "pattern_replace",
          "pattern": "oo",
          "replacement": "u"
        },
        "rk_diphthong": {
          "type": "pattern_replace",
          "pattern": "ai|ay|ei",
          "replacement": "e"
        },
        "rk_glide": {
          "type": "pattern_replace",
          "pattern": "y(?=[aeiou])|(?<=[aeiou])y",
          "replacement": ""
        },
        "rk_double": {
          "type": "pattern_replace",
          "pattern": "([b-df-hj-np-tv-z])\\1+",
          "replacement": "$1"
        }
      },
      "normalizer": {
        "en_keyword": {
          "type": "custom",
          "filter": [
            "lowercase",
            "asciifolding"
          ]
        },
        "ta_keyword": {
          "type": "custom",
          "char_filter": [
            "ta_clean"
          ],
          "filter": [
            "ta_nfc"
          ]
        }
      },
      "analyzer": {
        "en_text": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": [
            "lowercase",
            "asciifolding"
          ]
        },
        "en_stem": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": [
            "en_possessive",
            "lowercase",
            "asciifolding",
            "en_stem"
          ]
        },
        "en_prefix_index": {
          "type": "custom",
          "tokenizer": "edge_1_20",
          "filter": [
            "lowercase",
            "asciifolding"
          ]
        },
        "en_prefix_search": {
          "type": "custom",
          "tokenizer": "keyword",
          "filter": [
            "lowercase",
            "asciifolding"
          ]
        },
        "en_gram": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": [
            "lowercase",
            "asciifolding",
            "gram_3"
          ]
        },
        "ta_text": {
          "type": "custom",
          "char_filter": [
            "ta_clean"
          ],
          "tokenizer": "standard",
          "filter": [
            "ta_nfc"
          ]
        },
        "ta_prefix_index": {
          "type": "custom",
          "char_filter": [
            "ta_clean"
          ],
          "tokenizer": "standard",
          "filter": [
            "ta_nfc",
            "edge_1_15"
          ]
        },
        "ta_gram": {
          "type": "custom",
          "char_filter": [
            "ta_clean"
          ],
          "tokenizer": "standard",
          "filter": [
            "ta_nfc",
            "gram_2_3"
          ]
        },
        "roman_key": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": [
            "lowercase",
            "asciifolding",
            "rk_aspirates",
            "rk_zh",
            "rk_sh",
            "rk_voicing",
            "rk_voicing_d",
            "rk_voicing_b",
            "rk_w",
            "rk_ee",
            "rk_oo",
            "rk_diphthong",
            "rk_glide",
            "rk_double",
            "rk_long_vowels"
          ]
        }
      }
    }
  },
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "term_id": {
        "type": "long"
      },
      "text": {
        "type": "text",
        "analyzer": "en_text",
        "fields": {
          "exact": {
            "type": "keyword",
            "normalizer": "en_keyword"
          },
          "prefix": {
            "type": "text",
            "analyzer": "en_prefix_index",
            "search_analyzer": "en_prefix_search"
          },
          "stem": {
            "type": "text",
            "analyzer": "en_stem"
          },
          "gram": {
            "type": "text",
            "analyzer": "en_gram"
          }
        }
      },
      "aliases": {
        "type": "text",
        "analyzer": "en_text",
        "fields": {
          "exact": {
            "type": "keyword",
            "normalizer": "en_keyword"
          }
        }
      },
      "gloss": {
        "type": "text",
        "analyzer": "en_stem"
      },
      "renderings": {
        "type": "nested",
        "properties": {
          "suggestion_id": {
            "type": "long"
          },
          "tamil": {
            "type": "text",
            "analyzer": "ta_text",
            "fields": {
              "exact": {
                "type": "keyword",
                "normalizer": "ta_keyword"
              },
              "prefix": {
                "type": "text",
                "analyzer": "ta_prefix_index",
                "search_analyzer": "ta_text"
              },
              "gram": {
                "type": "text",
                "analyzer": "ta_gram"
              }
            }
          },
          "roman": {
            "type": "text",
            "analyzer": "roman_key",
            "fields": {
              "plain": {
                "type": "text",
                "analyzer": "en_text"
              }
            }
          },
          "forms": {
            "type": "keyword",
            "normalizer": "ta_keyword"
          },
          "domain": {
            "type": "keyword"
          },
          "source_kind": {
            "type": "keyword"
          },
          "status": {
            "type": "keyword"
          },
          "register": {
            "type": "keyword"
          },
          "region": {
            "type": "keyword"
          },
          "pos": {
            "type": "keyword"
          },
          "rating": {
            "type": "half_float"
          },
          "sense": {
            "type": "text",
            "analyzer": "en_stem"
          },
          "sources": {
            "type": "keyword"
          },
          "source_count": {
            "type": "short"
          }
        }
      },
      "tamil_synonyms": {
        "type": "text",
        "analyzer": "ta_text",
        "fields": {
          "exact": {
            "type": "keyword",
            "normalizer": "ta_keyword"
          }
        }
      },
      "has_tamil": {
        "type": "boolean"
      },
      "has_approved": {
        "type": "boolean"
      },
      "machine_only": {
        "type": "boolean"
      },
      "best_rating": {
        "type": "half_float"
      },
      "rendering_count": {
        "type": "short"
      },
      "source_count": {
        "type": "short"
      },
      "domains": {
        "type": "keyword"
      },
      "source_kinds": {
        "type": "keyword"
      },
      "sources": {
        "type": "keyword"
      },
      "licenses": {
        "type": "keyword"
      },
      "registers": {
        "type": "keyword"
      },
      "pos": {
        "type": "keyword"
      },
      "embedding": {
        "type": "knn_vector",
        "dimension": 384,
        "method": {
          "name": "hnsw",
          "engine": "lucene",
          "space_type": "cosinesimil",
          "parameters": {
            "m": 16,
            "ef_construction": 128
          }
        }
      },
      "embedding_model": {
        "type": "keyword"
      },
      "indexed_at": {
        "type": "date"
      }
    }
  }
}